# ============================================================
# iCELLSHOP / PRO BUYER - ROOT .GITIGNORE
# ============================================================

# --- 1. SECRETS & ENVIRONMENT CONFIGURATION (STRICT) ---
# Block all environment files and credentials
.env*
*.env
*.env.local
*.local
# Whitelist only the sanitized example file
!.env.example

# Private keys, certificates, keystores, and credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
*.pub

# --- 2. DEPENDENCIES (ALL WORKSPACES & SUBPACKAGES) ---
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- 3. BUILD OUTPUTS & BUNDLES ---
# Next.js
.next/
.next-local/
out/
**/out/

# Electron / Desktop builds
desktop/dist/
desktop/dist-electron/
desktop/release/
desktop/out/
**/dist/
**/dist-electron/
**/release/
electron.vite.config.*.mjs
**/electron.vite.config.*.mjs

# Mobile (Expo & React Native)
.expo/
**/apps/mobile/.expo/
.expo-shared/
web-build/
*.mobileprovision
*.orig.*

# Generic build directories
build/
**/build/

# --- 4. PYTHON ENVIRONMENTS & BYTECODE ---
.venv/
**/__pycache__/
*.py[cod]
*$py.class
venv/
ENV/

# --- 5. TESTING, COVERAGE & LOGS ---
coverage/
**/coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# --- 6. TYPESCRIPT & CACHES ---
*.tsbuildinfo
next-env.d.ts
.turbo/
.cache/

# --- 7. DEPLOYMENT PLATFORMS ---
.vercel/

# --- 8. OS & EDITOR FILES ---
.DS_Store
Thumbs.db
desktop.ini
*.code-workspace
.idea/
.vscode/*
!.vscode/settings.json
*.tmp
*.bak
*.swp
*.dump
*.sql

