{
  "name": "icellshoppos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "desktop",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:test": "node --test apps/mobile/test/mobile-capabilities.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "jose": "^6.1.3",
    "jsbarcode": "^3.11.6",
    "next": "16.1.6",
    "nodemailer": "^10.0.9",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-qr-code": "^2.0.15",
    "sharp": "^0.34.5",
    "stripe": "^20.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "react-native": {
      ".": "0.86.3",
      "@types/react": "$@types/react"
    },
    "@react-native/virtualized-lists": {
      "@types/react": "$@types/react"
    }
  }
}
