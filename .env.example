# ============================================================
# iCELLSHOP / PRO BUYER - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env.local and populate with your own values.
# NEVER commit .env.local or any real credentials to git!

# --- Application URLs & Admins ---
NEXT_PUBLIC_APP_URL=http://localhost:3007
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# --- Database (PostgreSQL / Docker) ---
DATABASE_URL="postgresql://icellshop:localpassword123@localhost:5432/icellshoppos_dev?schema=public"

# --- Authentication & Session Security ---
SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars-long
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMeImmediately!123

# --- Google OAuth & Google Sheets (Optional) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3007
NEXT_PUBLIC_SHEETS_ID=
NEXT_PUBLIC_SHEETS_INVENTORY_TAB=Inventory
NEXT_PUBLIC_SHEETS_DATA_TAB=Data
GOOGLE_API_KEY=

# --- Stripe Payments (Optional) ---
STRIPE_WEBHOOK_SECRET=

# --- Mail Delivery (Mailgun or Gmail SMTP) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=example.com
MAIL_FROM=no-reply@example.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Integrations (PitayaCore & Flow WhatsApp) ---
PITAYACORE_API_URL=https://pitayacore-api.pitayacode.io/api
PITAYACORE_API_KEY=
PITAYACORE_TENANT_ID=
FLOW_API_URL=https://flow-api.pitayacode.io
FLOW_INTERNAL_KEY=
