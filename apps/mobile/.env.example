# Safe defaults: Expo Go uses simulated flows and does not load native Stripe modules.
# Set STRIPE_TERMINAL_MODE=real in an iPad Development Build/EAS build for Bluetooth readers.
# Set TAP_TO_PAY_MODE=real later in an iPhone/EAS build prepared for Tap to Pay.
EXPO_PUBLIC_STRIPE_TERMINAL_MODE=simulated
EXPO_PUBLIC_TAP_TO_PAY_MODE=simulated
