{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "@ireader/contracts": ["../../packages/contracts/src/index.ts"],
      "@ireader/api-client": ["../../packages/api-client/src/index.ts"],
      "@ireader/application": ["../../packages/application/src/index.ts"],
      "@mobile/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx"
  ]
}
