{
  "name": "icellshoppos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "iReader by Pro Buyer — USB Apple device intake client",
  "main": "out/main/index.js",
  "type": "module",
  "build": {
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "appId": "com.icellshop.desktop",
    "productName": "iReader by Pro Buyer",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/libimobiledevice",
        "to": "libimobiledevice",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/iphone_probe.py",
        "to": "iphone_probe.py"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "pack:win-unpacked": "electron-builder --win dir --publish never",
    "release:win-zip": "node scripts/release-win-zip.mjs",
    "publish:s3": "node scripts/publish-s3.mjs"
  },
  "dependencies": {
    "bplist-parser": "^0.3.2",
    "electron-store": "^10.0.1",
    "lightweight-charts": "^4.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.20"
  }
}