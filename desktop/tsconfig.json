{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "electron"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@ireader/contracts": ["../packages/contracts/src/index.ts"],
      "@ireader/api-client": ["../packages/api-client/src/index.ts"],
      "@ireader/application": ["../packages/application/src/index.ts"]
    }
  },
  "include": ["src", "electron.vite.config.ts"]
}