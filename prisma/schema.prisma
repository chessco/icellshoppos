model DeviceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems InventoryItem[]
}
model Payment {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String
  stripePaymentId String?
  stripeSessionId String?
  amountCents     Int
  currency        String
  status          String
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum UserStatus {
  active
  inactive
}

enum Role {
  superadmin
  admin
  staff
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
}

enum ItemType {
  base
  extra_seat
}

enum CustomerType {
  retail
  wholesale
}

enum RepairStage {
  receive
  diagnosis
  repairing
  ready_for_pickup
  completed
  cancelled
}

enum RepairStatus {
  received
  pending_diagnosis
  quoted
  awaiting_approval
  approved
  disassembled
  parts_ordered
  parts_received
  working
  testing
  ready_for_pickup
  picked_up
  cancelled
}

enum DiscountAuthorizationStatus {
  PENDING
  APPROVED
  PARTIAL
  REJECTED
  CANCELLED
}

model Organization {
  id                     String             @id @default(uuid())
  name                   String
  slug                   String             @unique
  status                 OrganizationStatus @default(active)
  publicInventoryEnabled Boolean            @default(false)
  publicInventoryColumns String?
  modelCatalogJson       Json?
  carrierOptionsJson     Json?
  gradeOptionsJson       Json?
  conditionOptionsJson   Json?
  labelTemplateJson      Json?
  receiptConfigJson      Json?
  dioReminderJson        Json?
  logoData               Bytes?
  logoMimeType           String?
  useUsdConversion       Boolean            @default(true)
  repairCatalogJson      Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  memberships               Membership[]
  subscriptions             Subscription[]
  customers                 Customer[]
  suppliers                 Supplier[]
  partsSuppliers            PartsSupplier[]
  sites                     Site[]
  inventory                 InventoryItem[]
  sales                     Sale[]
  purchaseRequests          PurchaseRequest[]
  exchangeRates             ExchangeRate[]
  priceRules                PriceRule[]
  auditLogs                 AuditLog[]
  registerAudits            RegisterAudit[]
  payments                  Payment[]
  invites                   OrganizationInvite[]
  creditLedger              CreditLedger[]
  repairTickets             RepairTicket[]
  repairTypicalFailures     RepairTypicalFailure[]
  repairCustomers           RepairCustomer[]
  externalIntegrations      ExternalIntegrationCredential[]
  imeicheck2RequestLogs     ImeiCheck2RequestLog[]
  outgoingInventoryRequests InventoryTransferRequest[] @relation("InventoryTransferSourceOrg")
  incomingInventoryRequests InventoryTransferRequest[] @relation("InventoryTransferTargetOrg")
  chatMessages              ChatMessage[]
  discountAuthorizations    DiscountAuthorization[]
}

model ExternalIntegrationCredential {
  id                String    @id @default(uuid())
  organizationId    String
  provider          String
  email             String
  apiKeyEncrypted   String
  keyLast4          String
  confirmationToken String?
  tokenExpiresAt    DateTime?
  servicePricingJson Json?
  pricingUpdatedAt   DateTime?
  balance           Decimal? @db.Decimal(12, 2)
  balanceUpdatedAt  DateTime?
  linkedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([provider])
  @@index([organizationId, provider])
}

model ImeiCheck2RequestLog {
  id             String   @id @default(uuid())
  organizationId String
  serviceId      Int
  imei           String?
  imeisJson      Json?
  orderId        Int?
  status         String?
  charged        Decimal? @db.Decimal(12, 4)
  balance        Decimal? @db.Decimal(12, 4)
  responseJson   Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String?
  whatsapp     String?
  preferredLanguage String @default("en")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships            Membership[]
  auditLogs              AuditLog[]
  emailVerificationCodes EmailVerificationCode[]
  payments               Payment[]
  creditLedgerEntries    CreditLedger[]
  registerAudits         RegisterAudit[]
  assignedRepairTickets  RepairTicket[]      @relation("RepairAssignedTechnician")
  repairStatusLogs       RepairTicketStatusLog[]
  discountRequestsCreated  DiscountAuthorization[] @relation("DiscountRequestedBy")
  discountRequestsApproved DiscountAuthorization[] @relation("DiscountAuthorizedBy")
}

model EmailVerificationCode {
  id         String    @id @default(uuid())
  userId     String?
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

model Membership {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String
  role            Role
  permissionsJson Json?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvite {
  id               String   @id @default(uuid())
  organizationId   String
  email            String
  role             Role     @default(staff)
  permissionsJson  Json?
  tokenHash        String   @unique
  status           String   @default("pending")
  expiresAt        DateTime
  invitedByUserId  String?
  acceptedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([email, status, expiresAt])
}

model Plan {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  basePriceCents      Int
  includedSeats       Int      @default(1)
  extraSeatPriceCents Int
  trialDays           Int      @default(14)
  active              Boolean  @default(true)
  stripePriceId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  planId               String
  status               SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  items        SubscriptionItem[]

  @@unique([organizationId])
  @@index([planId])
}

model SubscriptionItem {
  id             String   @id @default(uuid())
  subscriptionId String
  itemType       ItemType
  quantity       Int      @default(1)
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Customer {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  email            String?
  whatsapp         String?
  customerType     CustomerType @default(retail)
  defaultPriceTier String   @default("Price")
  status           String   @default("Active")
  creditEnabled    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales         Sale[]
  creditLedger  CreditLedger[]
  repairTickets RepairTicket[]

  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PartsSupplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repairTickets RepairTicket[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RepairTypicalFailure {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RepairCustomer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  whatsapp       String?
  email          String?
  notes          String?
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repairTickets RepairTicket[]

  @@index([organizationId])
}

model Site {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ExchangeRate {
  id             String   @id @default(uuid())
  organizationId String
  usdToMxn       Decimal  @db.Decimal(12, 4)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AppBrandAsset {
  id        String   @id
  data      Bytes?
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceRule {
  id             String   @id @default(uuid())
  organizationId String
  model          String
  capacity       String
  price          Decimal  @db.Decimal(12, 2)
  price2         Decimal  @db.Decimal(12, 2)
  price3         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, model, capacity])
  @@index([organizationId])
}

model InventoryItem {
  id             String    @id @default(uuid())
  deviceTypeId   String?
  organizationId String
  siteId         String
  imei           String?
  sku            String?
  model          String
  capacity       String
  color          String
  carrier        String?
  condition      String?
  grade          String?
  status         String
  costUsd        Decimal?  @db.Decimal(12, 2)
  usdToPesosRate Decimal?  @db.Decimal(12, 4)
  costPesos      Decimal   @db.Decimal(12, 2)
  costCurrency   String    @default("MXN")
  price          Decimal   @db.Decimal(12, 2)
  price2         Decimal   @db.Decimal(12, 2)
  price3         Decimal   @db.Decimal(12, 2)
  supplierId     String?
  dateOfPurchase DateTime?
  batteryHealth  String?
  cycleCount     Int?
  iosVersion     String?
  serialNumber   String?
  comments       String?
  qrRaw          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                  Site                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supplier              Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  deviceType            DeviceType?             @relation(fields: [deviceTypeId], references: [id], onDelete: SetNull)
  saleItems             SaleItem[]
  importedTransferItems InventoryTransferItem[]

  @@unique([organizationId, imei])
  @@unique([organizationId, sku])
  @@index([deviceTypeId])
  @@index([organizationId, status])
  @@index([organizationId, siteId])
  @@index([supplierId])
}

model Sale {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  saleNumber     String
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  paymentMethod  String?
  notes          String?
  soldBy         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                  Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                     SaleItem[]
  inventoryTransferRequests InventoryTransferRequest[]
  creditLedger              CreditLedger[]
  completedRepairs          RepairTicket[]
  discountAuthorizations    DiscountAuthorization[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId, createdAt])
}

model RepairTicket {
  id                  String       @id @default(uuid())
  organizationId      String
  customerId          String?
  assignedTechnicianId String?
  completedSaleId     String?
  partsSupplierId     String?
    repairCustomerId    String?
  repairId            String       @default(cuid())
  repairNumber        String
  brand               String
  model               String
  color               String?
  imei                String?
  extrasJson          Json?
  notes               String?
  intakeFailuresJson  Json?
  intakeDiagnosisText String?
  possibleFixText     String?
  diagnosisText       String?
  diagnosisPending    Boolean      @default(false)
  quotedTotal         Decimal?     @db.Decimal(12, 2)
  partsCost           Decimal?     @db.Decimal(12, 2)
  stage               RepairStage  @default(receive)
  status              RepairStatus @default(received)
  customerName        String
  customerWhatsapp    String
  customerEmail       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  readyForPickupAt    DateTime?
  completedAt         DateTime?

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTechnician  User?                  @relation("RepairAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  completedSale       Sale?                  @relation(fields: [completedSaleId], references: [id], onDelete: SetNull)
  partsSupplier       PartsSupplier?         @relation(fields: [partsSupplierId], references: [id], onDelete: SetNull)
    repairCustomer      RepairCustomer?        @relation(fields: [repairCustomerId], references: [id], onDelete: SetNull)
  parts               RepairTicketPart[]
  statusLogs          RepairTicketStatusLog[]

  @@unique([organizationId, repairId])
  @@unique([organizationId, repairNumber])
  @@index([organizationId, stage, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([partsSupplierId])
  @@index([repairCustomerId])
}

model RepairTicketPart {
  id             String   @id @default(uuid())
  repairTicketId String
  name           String
  quantity       Int      @default(1)
  unitCost       Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@index([repairTicketId, createdAt])
}

model RepairTicketStatusLog {
  id             String       @id @default(uuid())
  repairTicketId String
  changedByUserId String?
  stage          RepairStage
  status         RepairStatus
  notes          String?
  createdAt      DateTime     @default(now())

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([repairTicketId, createdAt])
  @@index([changedByUserId, createdAt])
}

model InventoryTransferRequest {
  id                   String   @id @default(uuid())
  sourceOrganizationId String
  targetOrganizationId String
  saleId               String
  customerEmail        String
  status               String   @default("pending")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceOrganization Organization            @relation("InventoryTransferSourceOrg", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  targetOrganization Organization            @relation("InventoryTransferTargetOrg", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  sale               Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items              InventoryTransferItem[]

  @@unique([sourceOrganizationId, targetOrganizationId, saleId])
  @@index([targetOrganizationId, status, createdAt])
}

model InventoryTransferItem {
  id                      String    @id @default(uuid())
  requestId               String
  saleItemId              String?
  imei                    String
  model                   String
  capacity                String
  color                   String
  carrier                 String?
  condition               String?
  batteryHealth           String?
  cycleCount              Int?
  iosVersion              String?
  serialNumber            String?
  comments                String?
  qrRaw                   String?
  sourceCostPesos         Decimal   @db.Decimal(12, 2)
  sourceSalePrice         Decimal   @db.Decimal(12, 2)
  importedAt              DateTime?
  importedInventoryItemId String?
  createdAt               DateTime  @default(now())

  request               InventoryTransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  saleItem              SaleItem?                @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  importedInventoryItem InventoryItem?           @relation(fields: [importedInventoryItemId], references: [id], onDelete: SetNull)

  @@unique([requestId, imei])
  @@index([requestId, importedAt])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  inventoryItemId String?
  imei            String
  model           String
  capacity        String
  color           String
  salePrice       Decimal  @db.Decimal(12, 2)
  cost            Decimal  @db.Decimal(12, 2)
  status          String   @default("Finished")
  createdAt       DateTime @default(now())

  sale          Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?          @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  transferItems InventoryTransferItem[]

  @@index([saleId])
  @@index([inventoryItemId])
}

model PurchaseRequest {
  id                String   @id @default(uuid())
  organizationId    String
  requesterName     String
  requesterEmail    String
  requesterWhatsapp String?
  payload           Json
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model CreditLedger {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  saleId          String?
  type            String
  amount          Decimal  @db.Decimal(12, 2)
  note            String?
  paymentMethod   String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, createdAt])
  @@index([customerId, createdAt])
  @@index([saleId])
}

model RegisterAudit {
  id                    String   @id @default(uuid())
  organizationId        String
  auditedByUserId       String
  periodStartAt         DateTime
  periodEndAt           DateTime @default(now())
  expectedCashAmount    Decimal  @db.Decimal(12, 2)
  countedCashAmount     Decimal  @db.Decimal(12, 2)
  cashDifferenceAmount  Decimal  @db.Decimal(12, 2)
  expectedTransferAmount Decimal @db.Decimal(12, 2)
  countedTransferAmount  Decimal @db.Decimal(12, 2)
  transferDifferenceAmount Decimal @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditedBy    User         @relation(fields: [auditedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, periodStartAt])
  @@index([organizationId, periodEndAt])
  @@index([auditedByUserId, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id                String   @id @default(uuid())
  organizationId    String
  channel           String   @default("WHATSAPP") // "WHATSAPP" | "INTERNAL"
  conversationId    String   // phone number for WhatsApp, user ID/room for Internal
  senderId          String?
  senderName        String?
  recipientPhone    String?
  recipientName     String?
  recipientUserId   String?
  content           String   @db.Text
  direction         String   @default("OUTBOUND") // "OUTBOUND" | "INBOUND"
  status            String   @default("SENT")     // "SENT" | "DELIVERED" | "READ" | "FAILED"
  mediaUrl          String?  @db.Text
  providerMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel, conversationId, createdAt])
  @@index([organizationId, channel, createdAt])
}

model DiscountAuthorization {
  id                 String                      @id @default(uuid())
  organizationId     String
  draftSaleId        String
  completedSaleId    String?
  requestedByUserId  String
  authorizedByUserId String?
  status             DiscountAuthorizationStatus @default(PENDING)
  requestedDiscount  Decimal                     @db.Decimal(12, 2)
  approvedDiscount   Decimal                     @default(0) @db.Decimal(12, 2)
  reason             String
  responseNote       String?
  snapshotJson       Json
  createdAt          DateTime                    @default(now())
  respondedAt        DateTime?
  updatedAt          DateTime                    @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy   User         @relation("DiscountRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  authorizedBy  User?        @relation("DiscountAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  completedSale Sale?        @relation(fields: [completedSaleId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([draftSaleId])
  @@index([completedSaleId])
}
